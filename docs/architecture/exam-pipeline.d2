# Exam Pipeline — Full Detail

direction: down

title: {
  label: "📝 Pipeline Examen (SAP-C02)"
  style.font-size: 22
  near: top-center
}

# === INPUT ===
input: {
  label: "Input"
  style.fill: "#f5f5f5"

  origin: "Fichier original\n(.docx from Tutorials Dojo)" {
    style.fill: "#fff9c4"
  }
}

# === TRONC COMMUN ===
tronc: {
  label: "Tronc Commun (toujours exécuté)"
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"

  format: "STEP 1: FORMAT\norigin → word formatté (.docx)" {
    style.fill: "#bbdefb"
  }
  markdown: "STEP 2: MARKDOWN\nword → full markdown (.md)" {
    style.fill: "#bbdefb"
  }

  format -> markdown
}

input.origin -> tronc.format

# === BRANCHE ANKI ===
anki-branch: {
  label: "Branche ANKI (do_anki=true)"
  style.fill: "#e8f5e9"
  style.stroke: "#2e7d32"

  highlight: "STEP 3: HIGHLIGHT\nIdentifier réponses correctes" {
    style.fill: "#c8e6c9"
  }
  anki: "STEP 4: ANKI\nGénérer .apkg + compact .md" {
    style.fill: "#c8e6c9"
  }

  highlight -> anki

  # Highlight detail
  highlight-detail: {
    label: "Highlight — 3 tiers"
    style.fill: "#f1f8e9"
    style.stroke: "#689f38"

    tier1: "Tier 1: NotebookLM\n(si EXAM_USE_NLM=1)\nInput: .md\nBatch: EXAM_NLM_BATCH_SIZE" {style.fill: "#dcedc8"}
    tier2: "Tier 2: Bedrock (Claude)\nInput: .docx\nBatch: EXAM_BATCH_SIZE\nParallel: EXAM_PARALLEL_BATCHES" {style.fill: "#dcedc8"}
    tier3: "Tier 3: Regex\n(dernier recours)" {style.fill: "#dcedc8"}

    tier1 -> tier2: "si échec ou <80%" {style.stroke: "#f57c00"}
    tier2 -> tier3: "si questions manquantes" {style.stroke: "#f57c00"}
  }
}

tronc.markdown -> anki-branch.highlight

# === BRANCHE GÉNÉRATION ===
gen-branch: {
  label: "Branche GÉNÉRATION (do_generate=true)"
  style.fill: "#fce4ec"
  style.stroke: "#c62828"

  split: "SPLIT\n.md → .md chunks\n(questions_per_chunk)" {style.fill: "#ffcdd2"}
  db-insert: "DB INSERT\n→ parent_configuration\n→ podcast_download" {style.fill: "#ffcdd2"}
  generate: "NLM GENERATE\n(podcast audio)" {style.fill: "#ffcdd2"}

  split -> db-insert -> generate
}

tronc.markdown -> gen-branch.split

# === OUTPUTS ===
outputs: {
  label: "Outputs"
  style.fill: "#f5f5f5"

  apkg: ".apkg\nassets/exams/{sub}/Anki-generation/anki/" {style.fill: "#a5d6a7"}
  compact-md: "compact .md\nassets/exams/{sub}/Anki-generation/markdown/" {style.fill: "#a5d6a7"}
  podcast: "Podcast audio\n→ GNL-BACKLOG" {style.fill: "#ef9a9a"}
}

anki-branch.anki -> outputs.apkg
anki-branch.anki -> outputs.compact-md
gen-branch.generate -> outputs.podcast
