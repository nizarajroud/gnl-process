          <mxGeometry x="700" y="180" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- AWS API -->
        <mxCell id="aws-api" value="&lt;b&gt;AWS What's New API&lt;/b&gt;&lt;br&gt;(crawl mensuel)" style="rounded=1;whiteSpace=wrap;fillColor=#e3f2fd;strokeColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="700" y="280" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- Google Drive -->
        <mxCell id="gdrive" value="&lt;b&gt;Google Drive (G:)&lt;/b&gt;&lt;br&gt;/mnt/g/Mon Drive/GNL-BACKLOG/&lt;br&gt;(output final)" style="rounded=1;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#388e3c;" vertex="1" parent="1">
          <mxGeometry x="700" y="400" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- LinkedIn MCP -->
        <mxCell id="linkedin-mcp" value="&lt;b&gt;LinkedIn MCP Server&lt;/b&gt;&lt;br&gt;(stdio, on-demand)&lt;br&gt;timeout: 600s" style="rounded=1;whiteSpace=wrap;fillColor=#fce4ec;strokeColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="700" y="530" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Connections -->
        <mxCell id="c1" style="strokeColor=#e65100;" edge="1" parent="1" source="dev" target="nlm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" style="strokeColor=#e65100;" edge="1" parent="1" source="prod" target="nlm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" style="strokeColor=#e65100;" edge="1" parent="1" source="dev" target="bedrock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" style="strokeColor=#e65100;" edge="1" parent="1" source="dev" target="tts">
