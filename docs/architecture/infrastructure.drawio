        <mxCell id="c5" style="strokeColor=#1565c0;" edge="1" parent="1" source="prod" target="linkedin-mcp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" style="strokeColor=#388e3c;" edge="1" parent="1" source="prod" target="gdrive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Scheduler box -->
        <mxCell id="scheduler" value="&lt;b&gt;Scheduler (APScheduler)&lt;/b&gt;&lt;br&gt;02:00 — fetch LinkedIn&lt;br&gt;03:00 — generate articles&lt;br&gt;08:00 — deliver (disabled)" style="rounded=1;whiteSpace=wrap;fillColor=#f3e5f5;strokeColor=#7b1fa2;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="200" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
